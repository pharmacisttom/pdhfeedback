# ==========================================
# PdhFeedback - Environment Configuration
# ==========================================

# Application Port & URL
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database Connection (MySQL 8)
DATABASE_URL="mysql://root:@localhost:3306/pdhfeedback"

# JWT / Session Secrets (Generate via `openssl rand -hex 32`)
AUTH_SECRET="pdhfeedback_super_secure_auth_secret_key_2026_dev_only"
AUTH_SALT="pdhfeedback_ip_hasher_salt_2026"

# Email Configuration (Optional SMTP - if not configured, dev preview logger will be used)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="PdhFeedback <no-reply@pdhfeedback.local>"

# Webhook Security
WEBHOOK_SECRET_KEY="pdhfeedback_webhook_signing_secret_dev"

# System Environment
NODE_ENV="development"
